# Credenciais do projeto Supabase (Settings > API no painel do Supabase)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Modo demonstração: roda o app sem Supabase, com dados fictícios em memória (localStorage).
# Útil para validar telas antes de conectar o banco. Deixe vazio/false em produção.
VITE_DEMO=false

# ── Os três sistemas do grupo ────────────────────────────────────────
# Endereço de cada sistema, para o menu "Sistemas" no topo.
# Vazio esconde o item — é o que vale em desenvolvimento.
#
# O login é o mesmo nos três, a sessão ainda não: este app guarda em
# localStorage (por origem), o estoque em cookie, e a frota mora num projeto
# Supabase próprio. Hoje se entra uma vez de cada lado.
# Precisa ser o endereço COMPLETO, com https:// e sem sinal de "preencha aqui".
# Um valor inválido (o texto de exemplo, por engano) faz o item sumir do menu —
# de propósito: é assim que se descobre que a variável está errada.
VITE_URL_ESTOQUE=https://estoque.exemplo.com.br
VITE_URL_FROTA=https://frota.exemplo.com.br
